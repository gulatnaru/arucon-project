{
  "expo": {
    "name": "아루콘 개발 셸",
    "slug": "arucon-mobile",
    "scheme": "arucondev",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-dev-client",
      ["expo-asset", { "assets": ["./assets/arucon_tsundere_motion.glb"] }],
      [
        "./plugins/withAruconNativeIntegration",
        {
          "healthDeclarationsEnabled": false,
          "widgetTargetsEnabled": true
        }
      ]
    ],
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.arucon.dev" },
    "android": {
      "package": "com.arucon.dev",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "AruconWidget",
                  "bundleIdentifier": "com.arucon.dev.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.arucon.dev.widget"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}

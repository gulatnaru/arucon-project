import Foundation
import CoreFoundation
import ImageIO
import SwiftUI
import UIKit
import WidgetKit

private let snapshotKey = "arucon.widget.snapshot.v1"
private let developmentAppGroup = "group.com.arucon.dev.widget"
private let openAppURL = URL(string: "arucondev://open/widget")!

private enum DisplayState: String, Decodable {
  case awake
  case sleeping
  case hibernating
  case needsCare = "needs_care"
}

private struct PetProjection: Decodable {
  let petId: String
  let stateRevision: Int
  let updatedAtMs: Int64
  let formId: String
  let personalityProfileId: String
  let displayState: DisplayState
}

private enum WidgetViewStatus {
  case ready
  case stale
  case missing
  case error
  case unsupported
}

private enum StrictProjectionDecoder {
  private static let maximumSafeInteger: Int64 = 9_007_199_254_740_991
  private static let allowedKeys: Set<String> = [
    "petId", "stateRevision", "updatedAtMs", "formId", "personalityProfileId", "displayState"
  ]

  private static func isNonemptyString(_ value: Any?) -> Bool {
    guard let string = value as? String else { return false }
    return !string.isEmpty
  }

  private static func isSafeInteger(_ value: Any?) -> Bool {
    guard let number = value as? NSNumber,
          CFGetTypeID(number) != CFBooleanGetTypeID() else {
      return false
    }
    let integerTypeEncodings: Set<String> = ["c", "s", "i", "l", "q", "C", "S", "I", "L", "Q"]
    guard integerTypeEncodings.contains(String(cString: number.objCType)) else { return false }
    let integer = number.int64Value
    return integer >= 0 && integer <= maximumSafeInteger
  }

  static func decode(_ data: Data) -> PetProjection? {
    guard let object = try? JSONSerialization.jsonObject(with: data),
          let dictionary = object as? [String: Any],
          Set(dictionary.keys) == allowedKeys,
          isNonemptyString(dictionary["petId"]),
          isNonemptyString(dictionary["formId"]),
          isNonemptyString(dictionary["personalityProfileId"]),
          dictionary["displayState"] is String,
          isSafeInteger(dictionary["stateRevision"]),
          isSafeInteger(dictionary["updatedAtMs"]),
          let projection = try? JSONDecoder().decode(PetProjection.self, from: data),
          !projection.petId.isEmpty,
          !projection.formId.isEmpty,
          !projection.personalityProfileId.isEmpty,
          projection.stateRevision >= 0,
          projection.updatedAtMs >= 0,
          projection.stateRevision <= maximumSafeInteger,
          projection.updatedAtMs <= maximumSafeInteger else {
      return nil
    }
    return projection
  }
}

private enum SnapshotRead {
  case ready(PetProjection)
  case missing
  case error
}

private enum ReadOnlySnapshotStore {
  static func read() -> SnapshotRead {
    guard let defaults = UserDefaults(suiteName: developmentAppGroup) else { return .error }
    guard let data = defaults.data(forKey: snapshotKey) else { return .missing }
    guard let projection = StrictProjectionDecoder.decode(data) else { return .error }
    return .ready(projection)
  }
}

private enum WidgetPetArtwork {
  // The source PNG stays shared with Android. Decode a bounded iOS copy so WidgetKit can archive the view.
  private static let maximumPixelDimension = 384

  static let image: UIImage? = {
    guard let imageURL = Bundle.main.url(forResource: "arucon_widget_pet", withExtension: "png"),
          let imageSource = CGImageSourceCreateWithURL(imageURL as CFURL, nil),
          let thumbnail = CGImageSourceCreateThumbnailAtIndex(imageSource, 0, [
            kCGImageSourceCreateThumbnailFromImageAlways: true,
            kCGImageSourceCreateThumbnailWithTransform: true,
            kCGImageSourceShouldCacheImmediately: true,
            kCGImageSourceThumbnailMaxPixelSize: maximumPixelDimension,
          ] as CFDictionary) else {
      return nil
    }
    return UIImage(cgImage: thumbnail, scale: 1, orientation: .up)
  }()
}

private struct AruconWidgetEntry: TimelineEntry {
  let date: Date
  let status: WidgetViewStatus
  let projection: PetProjection?
}

private extension View {
  @ViewBuilder
  func aruconWidgetBackground(_ color: Color) -> some View {
    if #available(iOSApplicationExtension 17.0, *) {
      containerBackground(for: .widget) { color }
    } else {
      background(color)
    }
  }
}

private struct AruconWidgetProvider: TimelineProvider {
  private func entry() -> AruconWidgetEntry {
    switch ReadOnlySnapshotStore.read() {
    case .ready(let projection):
      return AruconWidgetEntry(date: Date(), status: .ready, projection: projection)
    case .missing:
      return AruconWidgetEntry(date: Date(), status: .missing, projection: nil)
    case .error:
      return AruconWidgetEntry(date: Date(), status: .error, projection: nil)
    }
  }

  func placeholder(in context: Context) -> AruconWidgetEntry {
    AruconWidgetEntry(date: Date(), status: .unsupported, projection: nil)
  }

  func getSnapshot(in context: Context, completion: @escaping (AruconWidgetEntry) -> Void) {
    completion(entry())
  }

  func getTimeline(in context: Context, completion: @escaping (Timeline<AruconWidgetEntry>) -> Void) {
    completion(Timeline(entries: [entry()], policy: .never))
  }
}

private struct AruconWidgetView: View {
  let entry: AruconWidgetEntry

  private let cardBackground = Color(red: 1.0, green: 0.976, blue: 0.941)
  private let primaryText = Color(red: 0.251, green: 0.200, blue: 0.180)
  private let secondaryText = Color(red: 0.357, green: 0.298, blue: 0.271)

  private var formDisplayName: String {
    switch entry.projection?.formId {
    case "mallu": return "말루"
    case "mono": return "모노"
    case "piko": return "피코"
    case "mongle": return "몽글"
    default: return "아루콘"
    }
  }

  private var stateText: String {
    switch entry.status {
    case .stale: return "마지막 확인 상태 · 앱에서 확인"
    case .missing, .error, .unsupported: return "앱에서 확인"
    case .ready:
      switch entry.projection?.displayState {
      case .awake: return "방에서 지내는 중"
      case .sleeping: return "쉬는 중"
      case .hibernating: return "잠시 쉬는 중"
      case .needsCare: return "앱에서 상태 확인"
      case nil: return "앱에서 확인"
      }
    }
  }

  private var lastUpdatedText: (date: String, time: String)? {
    guard let updatedAtMs = entry.projection?.updatedAtMs else { return nil }
    let updatedAt = Date(timeIntervalSince1970: Double(updatedAtMs) / 1_000)
    return (
      date: updatedAt.formatted(date: .numeric, time: .omitted),
      time: updatedAt.formatted(date: .omitted, time: .shortened)
    )
  }

  var body: some View {
    VStack(alignment: .leading, spacing: 6) {
      HStack(spacing: 8) {
        if let petImage = WidgetPetArtwork.image {
          Image(uiImage: petImage)
            .resizable()
            .scaledToFit()
            .frame(maxWidth: .infinity, maxHeight: .infinity)
            .accessibilityLabel("아루콘의 모습")
        }
        VStack(alignment: .leading, spacing: 3) {
          Text(formDisplayName)
            .font(.headline)
            .foregroundStyle(primaryText)
            .lineLimit(1)
          Text(stateText)
            .font(.caption)
            .foregroundStyle(secondaryText)
            .lineLimit(2)
        }
      }
      if let lastUpdatedText {
        VStack(alignment: .leading, spacing: 0) {
          Text("마지막 확인 · \(lastUpdatedText.date)")
            .lineLimit(1)
          Text(lastUpdatedText.time)
            .lineLimit(1)
        }
        .font(.caption2)
        .foregroundStyle(secondaryText)
        .minimumScaleFactor(0.75)
      }
    }
    .padding(12)
    .aruconWidgetBackground(cardBackground)
    .widgetURL(openAppURL)
  }
}

@main
struct AruconWidget: Widget {
  var body: some WidgetConfiguration {
    StaticConfiguration(kind: "AruconWidget", provider: AruconWidgetProvider()) { entry in
      AruconWidgetView(entry: entry)
    }
    .configurationDisplayName("아루콘")
    .description("마지막으로 확인된 아루콘 상태를 표시합니다.")
    .supportedFamilies([.systemSmall])
  }
}
